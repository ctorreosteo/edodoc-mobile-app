# Copia in ios/fastlane/.env (fuori da git) e compila.

# App Store Connect > Utenti e accessi > Integrazioni: chiave con ruolo Admin, serve a creare i certificati.
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
# Percorso assoluto del file .p8, fuori dal repo
APP_STORE_CONNECT_KEY_PATH=

# Solo per crea_app e privacy: Apple non permette queste due operazioni con la chiave API
APPLE_ID=

# Solo per rilascio: contatto e account per i revisori
APP_REVIEW_NOME=
APP_REVIEW_COGNOME=
APP_REVIEW_TELEFONO=
APP_REVIEW_EMAIL=
APP_REVIEW_PASSWORD_PAZIENTE=
APP_REVIEW_PASSWORD_DOTTORE=
